
# Docker Settings
DOCKER_IMAGE_BE='backend:0.1'
DOCKER_IMAGE_FE='frontend:0.1'
DOCKER_IMAGE_BROKER='broker:0.1'

# --- Project Settings ---
PROJECT_NAME="Smart Farming Hydroponic"
API_V1_STR="/api/v1"

# PostgreSQL Settings
POSTGRES_SERVER="db:5432" # Sesuaikan dengan nama service di docker yml
POSTGRES_USER="admin_lab"
POSTGRES_PASSWORD="admin123"
POSTGRES_DB="hydroponic_db"

# PGAdmin Settings
PGADMIN_DEFAULT_EMAIL="admin_lab@example.com"
PGADMIN_DEFAULT_PASSWORD="admin123"

# MQTT Broker Settings
MQTT_BROKER="broker" # Sesuaikan dengan nama service di docker yml
MQTT_PORT=1883
# MQTT_TOPIC="hydroponic/master"
MQTT_USERNAME="admin_lab"
MQTT_PASSWORD="admin123"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}/${POSTGRES_DB}"